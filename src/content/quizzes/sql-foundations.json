    {
      "id": "sf-05",
      "format": "matching",
      "prompt": "Match each SQL verb to its job.",
      "pairs": [
        {
          "term": "SELECT",
          "definition": "Chooses which columns to return"
        },
        {
          "term": "WHERE",
          "definition": "Filters which rows to return"
        },
        {
          "term": "INSERT",
          "definition": "Adds new rows"
        },
        {
          "term": "GROUP BY",
          "definition": "Splits rows into groups for aggregates"
        }
      ],
      "explanation": "Columns, rows, new rows, groups."
    },
    {
      "id": "sf-06",
      "format": "translate-code",
      "prompt": "Which JavaScript does the same?",
      "code": "SELECT name FROM Students WHERE age >= 18;",
      "from": "sql",
      "to": "javascript",
      "options": [
        "students.filter(s => s.age >= 18).map(s => s.name)",
        "students.map(s => s.name).filter(s => s.age >= 18)",
        "students.slice(0, 18)",
        "students.forEach(s => s.name)"
      ],
      "answer": 0,
      "explanation": "WHERE = filter first, then SELECT name = map. Order matters!"
    },
    {
      "id": "sf-07",
      "format": "predict-output",
      "prompt": "The table has 30 rows. What does this return?",
      "code": "SELECT COUNT(*) FROM Students;",
      "language": "sql",
      "options": [
        "30",
        "*",
        "0",
        "30 rows"
      ],
      "answer": 0,
      "explanation": "COUNT(*) collapses all rows into one number: 30."
