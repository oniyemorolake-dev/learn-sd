      "id": "sf-02",
      "format": "spot-the-bug",
      "prompt": "What's wrong?",
      "code": "SELECT name\nFROM Students\nWHERE city = Calgary;",
      "language": "sql",
      "options": [
        "Calgary needs single quotes — it's text",
        "WHERE comes before FROM",
        "SELECT needs *",
        "Nothing is wrong"
      ],
      "answer": 0,
      "explanation": "Bare Calgary looks like a column name. Text literals need 'single quotes'."
    },
    {
      "id": "sf-03",
      "format": "arrange-order",
      "prompt": "Order the clauses as they appear in a SELECT query.",
      "lines": [
        "WHERE",
        "SELECT ... FROM",
        "ORDER BY",
        "LIMIT"
      ],
      "answer": [
        1,
        0,
        2,
        3
      ],
      "explanation": "SELECT → WHERE → ORDER BY → LIMIT. That order is the law."
    },
    {
